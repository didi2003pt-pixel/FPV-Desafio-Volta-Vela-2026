NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=Desafio Volta à Vela

DATABASE_URL=postgresql://desafio:desafio_local@localhost:5432/desafio_volta?schema=public
DIRECT_URL=postgresql://desafio:desafio_local@localhost:5432/desafio_volta?schema=public
REDIS_URL=redis://localhost:6379

AUTH_PEPPER=replace-with-at-least-32-random-characters
AUTH_REQUIRE_EMAIL_VERIFICATION=true
SESSION_TTL_DAYS=30
RATE_LIMIT_FAIL_OPEN=true

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Desafio Volta à Vela <noreply@localhost>

TERMS_VERSION=2026-07-29
PRIVACY_VERSION=2026-07-29

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador

S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_BUCKET=desafio-volta
S3_ACCESS_KEY=desafio
S3_SECRET_KEY=desafio_local_storage
S3_FORCE_PATH_STYLE=true

SAILTI_BASE_URL=https://fpv.sailti.com
SAILTI_RACES_URL=https://fpv.sailti.com/pt/default/races
SAILTI_RESULTS_URL=https://fpv.sailti.com/pt/default/races/race-resultsall?text=volta-a-portugal-a-vela-2026-pt&menuaction=race

# Segredo para POST /api/cron/close-markets
CRON_SECRET=replace-with-at-least-24-random-characters
